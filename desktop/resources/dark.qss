/* ------------------------------------------------------------------ */
/* dark.qss：深色主题的「有限控件」样式（菜单/滚动条/工具栏等）             */
/* 全局背景/文字色改由 QPalette 提供（见 main.cpp），避免 QSS 通用          */
/* QWidget 选择器对每个控件都启用样式表引擎带来的内存/绘制开销。           */
/* ------------------------------------------------------------------ */

QToolBar {
    background-color: #12161a;
    border: none;
    spacing: 6px;
    padding: 6px;
}

QToolButton {
    background-color: #1a2026;
    color: #c8d0d8;
    border: 1px solid #2a313a;
    border-radius: 4px;
    padding: 6px 12px;
}

QToolButton:hover {
    border-color: #e8873a;
    color: #ffffff;
}

QStatusBar {
    background-color: #12161a;
    color: #8a949e;
    border-top: 1px solid #1c2228;
}

QStatusBar QLabel {
    color: #8a949e;
    padding: 0 8px;
}

QMenu {
    background-color: #151a1f;
    color: #c8d0d8;
    border: 1px solid #2a313a;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background-color: #e8873a;
    color: #ffffff;
}

QScrollBar:vertical {
    background: #0b0d0f;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #2a313a;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar:horizontal {
    background: #0b0d0f;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #2a313a;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
